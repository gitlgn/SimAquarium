# dependencies
node_modules/

# build output
dist/
dist-ssr/

# vite / tooling caches
.vite/
*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# raw asset packs — only the curated subset under public/gfx/ is committed
# (e.g. public/gfx/kenney/ from kenney.nl Fish Pack, CC0 — see ASSETS.md)
/kenney_*/

# editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db

# Android packaging (Bubblewrap TWA / Capacitor) — see docs/ANDROID.md
/android/
/ios/
# signing keys and build artifacts must never be committed
*.keystore
*.jks
*.aab
*.apk
android.keystore
.bubblewrap/

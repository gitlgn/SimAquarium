{
	"name": "simaquarium",
	"version": "3.0.0-dev",
	"description": "Aquarium simulation game — modernized web build (fork of xtrsyz/simaquarium)",
	"type": "module",
	"license": "GPL-2.0-only",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc -p jsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run typecheck && npm run lint && npm run test",
		"format": "prettier --write ."
	},
	"engines": {
		"node": ">=20.19"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.11"
	}
}

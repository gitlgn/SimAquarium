{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"noEmit": true,
		"skipLibCheck": true,
		"allowJs": true,
		"checkJs": false,

		"strict": true,
		// The data tables are typed now (tuple rows). What still trips
		// noImplicitAny is ~50 bare function params across aquarium/config/
		// events/dom — a mechanical annotation pass, tracked in MODERNIZATION.md.
		"noImplicitAny": false,
		"noUnusedLocals": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src", "test", "*.config.js"],
	"exclude": ["node_modules", "dist", "dev-dist"]
}

{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"checkJs": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["vite/client"],

		"strict": true,
		"noImplicitAny": false,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src/**/*.js", "*.config.js"],
	"exclude": ["node_modules", "dist", "dev-dist"]
}

{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"checkJs": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["vite/client"],

		// Pragmatic first pass: catch wrong names / arg counts / bad property
		// access without demanding a full DOM-null-safety pass on the 2014 code.
		// Tightening `strict` / `strictNullChecks` file-by-file is a follow-up.
		"strict": false,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"noImplicitThis": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src/**/*.js", "*.config.js"],
	"exclude": ["node_modules", "dist", "dev-dist"]
}
